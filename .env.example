# Environment configuration for docker-compose
# Copy this file to .env and customize for your environment

# CONFIG_PATH - path to configuration file inside container
CONFIG_PATH=/root/config/local.yml

# HOST_CONFIG_PATH - path to config directory on host machine  
HOST_CONFIG_PATH=./config

# APP_VERSION - application version (set automatically in CI/CD)
APP_VERSION=dev

# Examples for different environments:
#
# Local development (default):
# CONFIG_PATH=/root/config/local.yml
# HOST_CONFIG_PATH=./config
#
# Development environment with repo configs:
# CONFIG_PATH=/root/config/dev.yml  
# HOST_CONFIG_PATH=./config
#
# Production with external configs:
# CONFIG_PATH=/root/config/prod.yml
# HOST_CONFIG_PATH=/etc/clearscript/config